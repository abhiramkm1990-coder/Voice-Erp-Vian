# ====================================================================
# VianERP Enterprise Environment Variables Configuration
# Configure these variables in the Google AI Studio Settings / Secrets panel.
# ====================================================================

# 1. Google Gemini API Key (Required for WAI Assistant LLM reasoning & STT)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# 2. ElevenLabs API Key (For natural Malayalam & English text-to-speech audio)
# Get an API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# 3. OpenAI API Key (For Whisper-1 speech-to-text audio transcription)
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# 4. APP_URL: The URL where this applet is hosted.
# Automatically injected at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

